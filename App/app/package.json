{
  "name": "read-watch-library",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --win --x64 --dir",
    "package:win": "electron-builder --win --x64",
    "lint": "oxlint app components lib server vite.config.ts && oxlint electron",
    "format": "oxfmt",
    "hygiene": "python ../scripts/check_repository_hygiene.py",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@xyflow/react": "12.11.6",
    "lucide-react": "1.31.0",
    "mermaid": "12.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260901.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "35.7.5",
    "electron-builder": "26.15.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module",
  "build": {
    "appId": "com.readandwatch.app",
    "productName": "Read & Watch",
    "copyright": "Copyright © 2026 Read & Watch",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "Electronic Publication",
        "description": "Read & Watch EPUB Publication",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "Portable Document Format",
        "description": "Read & Watch PDF Document",
        "role": "Viewer"
      },
      {
        "ext": "mobi",
        "name": "Mobipocket Document",
        "description": "Read & Watch MOBI Document",
        "role": "Viewer"
      },
      {
        "ext": "azw",
        "name": "Amazon Kindle Document",
        "description": "Read & Watch AZW Document",
        "role": "Viewer"
      },
      {
        "ext": "azw3",
        "name": "Amazon Kindle Format 8",
        "description": "Read & Watch AZW3 Document",
        "role": "Viewer"
      },
      {
        "ext": "fb2",
        "name": "FictionBook 2.0",
        "description": "Read & Watch FB2 Document",
        "role": "Viewer"
      },
      {
        "ext": "fbz",
        "name": "Compressed FictionBook",
        "description": "Read & Watch FBZ Document",
        "role": "Viewer"
      },
      {
        "ext": "cbz",
        "name": "Comic Book Archive",
        "description": "Read & Watch CBZ Document",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
